# ---------- Server ----------
NODE_ENV=development
PORT=4000
APP_BASE_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000
# Comma separated, or * in development
CORS_ORIGINS=*

# ---------- Database ----------
DATABASE_URL=postgres://edu:edu_password@localhost:5432/edu_platform

# ---------- Auth ----------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_string_at_least_32_chars
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=12
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
# Return the OTP in API responses (development/testing only — ignored in production)
OTP_DEV_ECHO=true

# ---------- Seed admin ----------
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe!2026

# ---------- Email (leave SMTP_HOST empty to print emails to the console) ----------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Edu Platform <no-reply@example.com>"

# ---------- Gemini (leave GEMINI_API_KEY empty to use a mock response in development) ----------
GEMINI_API_KEY=
# Defaults only — the admin picks the model and its prices in the dashboard (Settings → الذكاء الاصطناعي).
GEMINI_MODEL=gemini-3.8-flash
# USD per 1M tokens — check current pricing at https://ai.google.dev/pricing
GEMINI_INPUT_USD_PER_M=1.50
GEMINI_OUTPUT_USD_PER_M=7.50
# Includes the model's short "thinking" (billed as output)
GEMINI_MAX_OUTPUT_TOKENS=2048
USD_TO_EGP=50
AI_LIMIT_EGP=100

# ---------- Paymob (Accept / Intention API) ----------
PAYMOB_BASE_URL=https://accept.paymob.com
PAYMOB_SECRET_KEY=
PAYMOB_PUBLIC_KEY=
PAYMOB_HMAC_SECRET=
PAYMOB_INTEGRATION_ID=

# ---------- Fawry ----------
FAWRY_BASE_URL=https://atfawry.fawrystaging.com
FAWRY_MERCHANT_CODE=
FAWRY_SECURE_KEY=

# ---------- Manual payments (shown to students) ----------
VODAFONE_CASH_NUMBER=010XXXXXXXX
INSTAPAY_ADDRESS=yourname@instapay

# ---------- Jobs ----------
ENABLE_CRON=true
TZ_NAME=Africa/Cairo

# ---------- Rate limiting ----------
# Max auth requests (login/register/OTP verify) per IP per 15 minutes. High on purpose: many students share one IP
# (mobile networks, centres). Wrong passwords are limited per account (10 / 15 min) in src/services/login-guard.js.
AUTH_RATE_LIMIT=300

# ---------- Deployment ----------
# Public test deployment: keep OTP-on-screen / simulated payments / mock AI even in production. NEVER on the real platform.
DEMO_MODE=false
# Required by hosted Postgres reached over the public network (Neon URLs already include sslmode=require)
DATABASE_SSL=false
# Secret for Vercel Cron → /api/cron/<job>
CRON_SECRET=
