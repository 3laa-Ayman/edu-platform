{
  "name": "edu-platform-api",
  "version": "1.0.0",
  "description": "MVP backend for an Egyptian e-learning platform (Express + PostgreSQL)",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:migrate": "node scripts/migrate.js",
    "db:seed": "node scripts/seed.js",
    "excel:template": "node scripts/make-excel-template.js",
    "test:smoke": "node scripts/smoke-test.js",
    "start:render": "node scripts/migrate.js && node scripts/seed.js && node src/server.js"
  },
  "license": "UNLICENSED",
